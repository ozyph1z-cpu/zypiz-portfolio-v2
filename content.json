  "faq": [
    {
      "publish": true,
      "q": "What is AI and what stays real in your ads?",
      "a": "The product stays real: app screens, packs, cards and prices come from real footage. AI makes what you can't shoot, like scenes, voices and characters. Anything a viewer can check on screen matches the footage."
    },
    {
      "publish": true,
      "q": "Which platforms do you cut for?",
      "a": "Meta (Facebook and Instagram), TikTok and YouTube Shorts, all in vertical 9:16. Each hook is cut as its own variation so you can test them against each other."
    },
    {
      "publish": true,
      "q": "What do you need from me?",
      "a": "The offer, any raw footage or screen recordings, and the ads that already work for you. A product page is enough to start."
